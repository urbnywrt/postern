{
  "log": {
    "access": "none",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "in-0123456789ab",
      "listen": "127.0.0.1",
      "port": 35001,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "block",
      "protocol": "blackhole"
    },
    {
      "tag": "out-0123456789ab",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "cdn.example.com",
            "port": 443,
            "users": [
              {
                "id": "11111111-2222-3333-4444-555555555555",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "cdn.example.com",
          "fingerprint": "firefox",
          "alpn": [
            "http/1.1"
          ]
        },
        "wsSettings": {
          "path": "/ws?ed=2048",
          "host": "cdn.example.com"
        }
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "inboundTag": [
          "in-0123456789ab"
        ],
        "outboundTag": "out-0123456789ab"
      }
    ]
  }
}
