{
  "log": {
    "access": "none",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "in-0123456789ab",
      "listen": "127.0.0.1",
      "port": 35001,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "block",
      "protocol": "blackhole"
    },
    {
      "tag": "out-0123456789ab",
      "protocol": "shadowsocks",
      "settings": {
        "servers": [
          {
            "address": "ss.example.com",
            "port": 8388,
            "method": "chacha20-ietf-poly1305",
            "password": "pass-pass-pass"
          }
        ]
      },
      "streamSettings": {
        "network": "raw",
        "security": "none"
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "inboundTag": [
          "in-0123456789ab"
        ],
        "outboundTag": "out-0123456789ab"
      }
    ]
  }
}
